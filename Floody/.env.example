# Public Expo client configuration. Values prefixed EXPO_PUBLIC_ are included in app bundles.
# Never place passwords, service-role keys, or other privileged secrets here.
EXPO_PUBLIC_ALERTS_URL=https://radarmeteorologico.com.br/api/v1/alertas
EXPO_PUBLIC_WEATHER_URL=https://api.open-meteo.com/v1/forecast
EXPO_PUBLIC_GEOCODING_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_ROUTING_URL=https://router.project-osrm.org
EXPO_PUBLIC_VEHICLE_CATALOG_URL=https://parallelum.com.br/fipe/api/v1
EXPO_PUBLIC_MAP_TILES_LIGHT=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILES_DARK=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILES_SATELLITE=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
